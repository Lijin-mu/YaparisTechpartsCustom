{% sw_extends '@Storefront/storefront/page/checkout/confirm/index.html.twig' %}

{% set paymentMethodIds = config('YaparisTechpartsCustom.config.paymentMethodIds', context.salesChannel.id) %}

{# Normalize to array (critical for safety) #}
{% if paymentMethodIds is not iterable %}
	{% set paymentMethodIds = paymentMethodIds ? [paymentMethodIds] : [] %}
{% endif %}

{% block page_checkout_confirm_tos_control %}
	{{ parent() }}

	{% if context.paymentMethod.id in paymentMethodIds %}
		<div class="form-check mt-3">
			{% block page_checkout_confirm_warrenty_claim_control_checkbox %}
				<input type="checkbox" class="checkout-confirm-warrenty-claim-checkbox form-check-input{% if formViolations.getViolations('/tos') is not empty %} is-invalid{% endif %}" required="required" id="warrentyClaimCheck" form="confirmOrderForm" name="warrentyClaimCheck">
			{% endblock %}

			{% block page_checkout_confirm_warrenty_claim_control_label %}
				<label for="warrentyClaimCheck" class="checkout-confirm-tos-label custom-control-label">
					{{ 'custom.checkout.mandatory1'|trans|raw }}
				</label>
			{% endblock %}
		</div>
	{% endif %}
{% endblock %}

{% block page_checkout_confirm_form_submit %}
	<div class="d-grid">
		<button id="confirmFormSubmit" class="btn btn-primary btn-lg" form="confirmOrderForm" {% if page.cart.errors.blockResubmit %} disabled {% endif %} type="submit">
			{% if context.paymentMethod.id in paymentMethodIds %}
				<span>{{ "techparts.checkout.confirmClaim"|trans|sw_sanitize }}</span>
			{% else %}
				<span>{{ "techparts.checkout.confirmSubmit"|trans|sw_sanitize }}</span>
			{% endif %}
		</button>
	</div>
{% endblock %}


{% block page_checkout_additional %}
	{% if context.paymentMethod.id not in paymentMethodIds %}
		{{parent()}}
	{% endif %}
{% endblock %}

{% block page_checkout_aside_actions %}
	{{parent()}}
	{% if context.paymentMethod.id in paymentMethodIds %}
		{% block page_checkout_additional_sidebar %}
			{% if config('core.cart.showCustomerComment') %}
				{% block page_checkout_finish_customer_comment_sidebar %}
					<div class="card checkout-card mt-5">
						<div class="card-body">
							{% block page_checkout_confirm_customer_comment_header_sidebar %}
								<div class="card-title">
									{{ 'checkout.customerCommentHeader'|trans|sw_sanitize }}
								</div>
							{% endblock %}

							{% block page_checkout_confirm_customer_comment_control_sidebar %}
								<div class="checkout-customer-comment-control">
									{% block page_checkout_confirm_customer_comment_control_textfield_label_sidebar %}
										<label class="form-label" for="{{ constant('Shopware\\Core\\Checkout\\Order\\SalesChannel\\OrderService::CUSTOMER_COMMENT_KEY') }}">
											{{ 'checkout.customerCommentLabel'|trans|sw_sanitize }}
										</label>
									{% endblock %}

									{% block page_checkout_confirm_customer_comment_control_textfield_sidebar %}
										<textarea class="form-control" placeholder="{{ 'checkout.customerCommentPlaceholder'|trans|sw_sanitize }}" id="{{ constant('Shopware\\Core\\Checkout\\Order\\SalesChannel\\OrderService::CUSTOMER_COMMENT_KEY') }}" form="confirmOrderForm" name="{{ constant('Shopware\\Core\\Checkout\\Order\\SalesChannel\\OrderService::CUSTOMER_COMMENT_KEY') }}"></textarea>
									{% endblock %}
								</div>
							{% endblock %}
						</div>
					</div>
				{% endblock %}
			{% endif %}
		{% endblock %}
	{% endif %}
{% endblock %}

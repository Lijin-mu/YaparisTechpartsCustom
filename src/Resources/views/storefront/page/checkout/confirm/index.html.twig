{% sw_extends '@Storefront/storefront/page/checkout/confirm/index.html.twig' %}

{% set paymentMethodIds = config('YaparisTechpartsCustom.config.paymentMethodIds', context.salesChannel.id) %}

{# Normalize to array (critical for safety) #}
{% if paymentMethodIds is not iterable %}
	{% set paymentMethodIds = paymentMethodIds ? [paymentMethodIds] : [] %}
{% endif %}

{% block page_checkout_confirm_tos_control %}
	{{ parent() }}

	{% if context.paymentMethod.id in paymentMethodIds %}
		<div class="form-check mt-3">
			<input type="checkbox" class="checkout-confirm-warrenty-claim-checkbox form-check-input{% if formViolations.getViolations('/tos') is not empty %} is-invalid{% endif %}" required="required" id="warrentyClaimCheck" form="confirmOrderForm" name="warrentyClaimCheck">
			<label for="warrentyClaimCheck" class="checkout-confirm-tos-label custom-control-label">
				{{ 'custom.checkout.mandatory1'|trans|raw }}
			</label>
		</div>
	{% endif %}
{% endblock %}

{% block page_checkout_additional %}
{% endblock %}

{% block page_checkout_confirm_product_table %}
	<div class="confirm-product">
	{% block page_checkout_confirm_table_container %}
		<div class="card">
			<ul class="card-body list-unstyled">
				{% block page_checkout_confirm_table_header %}
					{% sw_include '@Storefront/storefront/component/checkout/cart-header.html.twig' with {
						showTaxPrice: showTaxPrice,
						showSubtotal: showSubtotal
					} %}
				{% endblock %}

				{% block page_checkout_confirm_table_items %}
					{% for lineItem in page.cart.lineItems %}
						{% block page_checkout_confirm_table_item %}
							{% sw_include '@Storefront/storefront/component/line-item/line-item.html.twig' with {
								redirectTo: 'frontend.checkout.confirm.page',
								showTaxPrice: showTaxPrice,
								showSubtotal: showSubtotal
							} %}
						{% endblock %}
					{% endfor %}
				{% endblock %}
			</ul>
		</div>
{% endblock %}
</div>
{% endblock %}

{% block page_checkout_aside_actions %}
	<div class="checkout-aside-action">
		<form id="confirmOrderForm"
			  action="{{ path('frontend.checkout.finish.order') }}"
			  data-form-preserver="true"
			  data-form-submit-loader="true"
			  data-form-add-history="true"
			  data-form-add-history-options="{{ {
				  entries: [{
					  state: {},
					  title: 'account.ordersTitle'|trans,
					  url: path('frontend.account.order.page')
				  }]
			  }|json_encode }}"
			  method="post">

			<input type="text" name="hash" hidden="hidden" value="{{ page.cart.getHash }}">

			<div class="d-grid">
				<button id="confirmFormSubmit" class="btn btn-primary btn-lg" form="confirmOrderForm" {% if page.cart.errors.blockResubmit %} disabled {% endif %} type="submit">
					{% if context.paymentMethod.id in paymentMethodIds %}
						<span>{{ "techparts.checkout.confirmClaim"|trans|sw_sanitize }}</span>
					{% else %}
						<span>{{ "techparts.checkout.confirmSubmit"|trans|sw_sanitize }}</span>
					{% endif %}
				</button>
			</div>
		</form>

		{% if bpaIsAllowedUploadingFiles is defined
			and bpaIsAllowedUploadingFiles is same as(true)
			and bpaIsOrdersFileUploadShowOnCheckoutConfirm is defined
			and bpaIsOrdersFileUploadShowOnCheckoutConfirm %}
			<div class="mt-3 yaparis-checkout-aside-upload">
				{% sw_include '@BpaPlatformOrdersFileUpload/storefront/component/orders-file-upload/cart-upload-form.html.twig' ignore missing with {
					page: page,
					uploadRedirect: 'frontend.checkout.confirm.page',
					isOffcanvas: true
				} %}

				{% sw_include '@BpaPlatformOrdersFileUpload/storefront/component/orders-file-upload/cart-uploaded-files.html.twig' ignore missing with {
					page: page,
					withoutDeleteBtn: true,
					uploadRedirect: 'frontend.checkout.confirm.page',
					isOffcanvas: true
				} %}
			</div>
		{% endif %}
	</div>

	{% if context.paymentMethod.id in paymentMethodIds and config('core.cart.showCustomerComment') %}
		<div class="card checkout-card mt-5">
			<div class="card-body">
				<div class="card-title">
					{{ 'checkout.customerCommentHeader'|trans|sw_sanitize }}
				</div>
				<div class="checkout-customer-comment-control">
					<label class="form-label" for="{{ constant('Shopware\\Core\\Checkout\\Order\\SalesChannel\\OrderService::CUSTOMER_COMMENT_KEY') }}">
						{{ 'checkout.customerCommentLabel'|trans|sw_sanitize }}
					</label>
					<textarea class="form-control" placeholder="{{ 'checkout.customerCommentPlaceholder'|trans|sw_sanitize }}" id="{{ constant('Shopware\\Core\\Checkout\\Order\\SalesChannel\\OrderService::CUSTOMER_COMMENT_KEY') }}" form="confirmOrderForm" name="{{ constant('Shopware\\Core\\Checkout\\Order\\SalesChannel\\OrderService::CUSTOMER_COMMENT_KEY') }}"></textarea>
				</div>
			</div>
		</div>
	{% endif %}
{% endblock %}

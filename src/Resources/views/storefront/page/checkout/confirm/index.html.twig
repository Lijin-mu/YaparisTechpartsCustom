{% sw_extends '@Storefront/storefront/page/checkout/confirm/index.html.twig' %}


 {% block page_checkout_confirm_tos_control %}
    {{ parent() }}
    {% set warrentyClaimPaymentTechnicalName = config('YaparisTechpartsCustom.warrentyClaimPaymentTechnicalName') %}
    {% if context.paymentMethod.technicalName == config('YaparisTechpartsCustom.warrentyClaimPaymentTechnicalName') %}
        <h2>selected payment method</h2>
    {% endif %}
    <div class="form-check mt-3">
        {% block page_checkout_confirm_warrenty_claim_control_checkbox %}
            <input type="checkbox"
                class="checkout-confirm-warrenty-claim-checkbox form-check-input{% if formViolations.getViolations('/tos') is not empty %} is-invalid{% endif %}"
                required="required"
                id="warrentyClaimCheck"
                form="confirmOrderForm"
                name="warrentyClaimCheck">
        {% endblock %}

        {% block page_checkout_confirm_warrenty_claim_control_label %}
            <label for="warrentyClaimCheck"
                class="checkout-confirm-tos-label custom-control-label">
                {{ 'custom.checkout.mandatory1'|trans|raw }}
            </label>
        {% endblock %}
    </div>
{% endblock %}

{% block page_checkout_confirm_form_submit %}
	{% set paymentClaim = false %}
	{% if selectedPaymentMethodId is not defined %}
		{% set selectedPaymentMethodId = context.paymentMethod.id %}
	{% endif %}
	{% for payment in page.paymentMethods %}
		{% set paymentName = payment.translated.name %}
		{% if payment.id is same as(selectedPaymentMethodId) %}
			{% if paymentName =='Gewährleistungsantrag' %}
				{% set paymentClaim = true %}
			{% endif %}
		{% endif %}
	{% endfor %}
	<div class="d-grid">
		<button id="confirmFormSubmit" class="btn btn-primary btn-lg" form="confirmOrderForm" {% if page.cart.errors.blockResubmit %} disabled {% endif %} type="submit">
			{% if paymentClaim %}
				<span>{{ "techparts.checkout.confirmClaim"|trans|sw_sanitize }}</span>
			{% else %}
				<span>{{ "techparts.checkout.confirmSubmit"|trans|sw_sanitize }}</span>
			{% endif %}
		</button>
	</div>
{% endblock %}
